// Prisma Schema for Production Home Food Marketplace on Vercel with PostgreSQL / Neon
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  COOKER
  RIDER
  ADMIN
}

enum CookerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RiderStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum ProductStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryMode {
  PLATFORM_DELIVERY
  SELF_DELIVERY
  CUSTOMER_PICKUP
}

enum PaymentMethod {
  UPI
  CARD
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  isVerified    Boolean   @default(false)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customerProfile       CustomerProfile?
  cookerProfile         CookerProfile?
  deliveryPersonProfile DeliveryPersonProfile?
  auditLogs             AuditLog[]
  notifications         Notification[]
}

model CustomerProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedAddresses Address[]
  cart           Cart?
  orders         Order[]
  reviews        Review[]
}

model Address {
  id                String           @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile  @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  label             String           @default("Home")
  street            String
  city              String
  pincode           String
  latitude          Float
  longitude         Float
  isDefault         Boolean          @default(false)
  orders            Order[]
}

model CookerProfile {
  id                        String       @id @default(uuid())
  userId                    String       @unique
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName                 String
  bio                       String
  logoUrl                   String
  coverImageUrl             String
  status                    CookerStatus @default(PENDING)
  rating                    Float        @default(5.0)
  totalReviews              Int          @default(0)
  totalOrders               Int          @default(0)
  fssaiLicenseNumber        String?
  address                   String
  latitude                  Float
  longitude                 Float
  platformDeliveryEnabled   Boolean      @default(true)
  selfDeliveryEnabled       Boolean      @default(true)
  customerPickupEnabled     Boolean      @default(true)
  selfDeliveryRadiusKm      Float        @default(5.0)
  platformDeliveryRadiusKm  Float        @default(10.0)
  minimumOrderValue         Decimal      @default(150.0) @db.Decimal(10, 2)
  averagePrepTimeMinutes    Int          @default(45)
  maxDailyCapacity          Int          @default(15)
  isOpenToday               Boolean      @default(true)
  openingHours              String       @default("09:00 AM - 08:00 PM")
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  products                  Product[]
  orders                    Order[]
  reviews                   Review[]
  payoutLedgers             PayoutLedger[]
}

model DeliveryPersonProfile {
  id                String      @id @default(uuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType       String      @default("BIKE")
  vehicleNumber     String
  currentLatitude   Float
  currentLongitude  Float
  status            RiderStatus @default(OFFLINE)
  isActive          Boolean     @default(true)
  deliveryRadiusKm  Float       @default(8.0)
  rating            Float       @default(5.0)
  totalDeliveries   Int         @default(0)
  todayEarnings     Decimal     @default(0.0) @db.Decimal(10, 2)
  totalEarnings     Decimal     @default(0.0) @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())

  assignments       DeliveryAssignment[]
}

model Category {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  imageUrl     String
  description  String
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  subcategories SubCategory[]
  products     Product[]
}

model SubCategory {
  id         String    @id @default(uuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  isActive   Boolean   @default(true)
  products   Product[]
}

model Tag {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  color     String?
  isDietary Boolean      @default(false)
  products  ProductTag[]
}

model MasterIngredient {
  id                 String              @id @default(uuid())
  name               String              @unique
  standardUnit       String              @default("g")
  caloriesPer100     Float
  proteinPer100      Float
  carbsPer100        Float
  fatPer100          Float
  saturatedFatPer100 Float?
  sugarPer100        Float
  fiberPer100        Float
  sodiumPer100       Float?
  allergens          IngredientAllergen[]
  productIngredients ProductIngredient[]
}

model Allergen {
  id          String               @id @default(uuid())
  name        String               @unique
  ingredients IngredientAllergen[]
}

model IngredientAllergen {
  ingredientId String
  allergenId   String
  ingredient   MasterIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  allergen     Allergen         @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([ingredientId, allergenId])
}

model Product {
  id                  String              @id @default(uuid())
  cookerId            String
  cooker              CookerProfile       @relation(fields: [cookerId], references: [id], onDelete: Cascade)
  name                String
  slug                String              @unique
  description         String
  categoryId          String
  category            Category            @relation(fields: [categoryId], references: [id])
  subcategoryId       String?
  subcategory         SubCategory?        @relation(fields: [subcategoryId], references: [id])
  price               Decimal             @db.Decimal(10, 2)
  netWeightGrams      Float
  servingSizeGrams    Float
  servingsCount       Int                 @default(1)
  prepTimeMinutes     Int                 @default(45)
  maxWaitLimitMinutes Int                 @default(60)
  isAvailable         Boolean             @default(true)
  stockCount          Int                 @default(10)
  dailyCapacity       Int                 @default(15)
  bookedToday         Int                 @default(0)
  supportsPreorder    Boolean             @default(true)
  status              ProductStatus       @default(APPROVED)
  rating              Float               @default(5.0)
  reviewCount         Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  images              ProductImage[]
  tags                ProductTag[]
  ingredients         ProductIngredient[]
  nutritionProfile    NutritionProfile?
  orderItems          OrderItem[]
  reviews             Review[]
  cartItems           CartItem[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductIngredient {
  id           String            @id @default(uuid())
  productId    String
  ingredientId String?
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   MasterIngredient? @relation(fields: [ingredientId], references: [id])
  name         String
  quantity     Float
  unit         String
}

model NutritionProfile {
  id                  String   @id @default(uuid())
  productId           String   @unique
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  totalCalories       Float
  totalProtein        Float
  totalCarbs          Float
  totalFat            Float
  totalSugar          Float
  totalFiber          Float
  per100Calories      Float
  per100Protein       Float
  per100Carbs         Float
  per100Fat           Float
  per100Sugar         Float
  per100Fiber         Float
  aiSummary           String?
  aiHealthGrade       String?
  aiSugarLevel        String?
  aiCalorieDensity    String?
}

model Cart {
  id                String     @id @default(uuid())
  customerProfileId String     @unique
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  items             CartItem[]
  updatedAt         DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
}

model Order {
  id                  String         @id @default(uuid())
  orderNumber         String         @unique
  customerId          String
  customerProfile     CustomerProfile @relation(fields: [customerId], references: [id])
  cookerId            String
  cooker              CookerProfile  @relation(fields: [cookerId], references: [id])
  subtotal            Decimal        @db.Decimal(10, 2)
  deliveryFee         Decimal        @db.Decimal(10, 2)
  platformFee         Decimal        @db.Decimal(10, 2)
  discountAmount      Decimal        @default(0.0) @db.Decimal(10, 2)
  couponCode          String?
  totalAmount         Decimal        @db.Decimal(10, 2)
  platformCommission  Decimal        @db.Decimal(10, 2)
  netCookerEarnings   Decimal        @db.Decimal(10, 2)
  deliveryAddressId   String
  deliveryAddress     Address        @relation(fields: [deliveryAddressId], references: [id])
  deliveryMode        DeliveryMode   @default(PLATFORM_DELIVERY)
  deliverySlotDate    String
  deliverySlotTime    String
  isPreorder          Boolean        @default(false)
  paymentMethod       PaymentMethod  @default(UPI)
  paymentStatus       PaymentStatus  @default(PENDING)
  status              OrderStatus    @default(PENDING)
  maxWaitLimitMinutes Int            @default(45)
  specialInstructions String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  items               OrderItem[]
  timelineEvents      OrderStatusHistory[]
  deliveryAssignments DeliveryAssignment[]
  reviews             Review[]
  payouts             PayoutLedger[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  totalPrice  Decimal  @db.Decimal(10, 2)
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  timestamp   DateTime    @default(now())
  description String
  actor       String?
}

model DeliveryAssignment {
  id          String                @id @default(uuid())
  orderId     String
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId     String
  rider       DeliveryPersonProfile @relation(fields: [riderId], references: [id])
  assignedAt  DateTime              @default(now())
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  status      String                @default("ASSIGNED")
}

model PayoutLedger {
  id             String        @id @default(uuid())
  cookerId       String
  cooker         CookerProfile @relation(fields: [cookerId], references: [id])
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  grossAmount    Decimal       @db.Decimal(10, 2)
  commissionFee  Decimal       @db.Decimal(10, 2)
  netEarnings    Decimal       @db.Decimal(10, 2)
  payoutStatus   String        @default("PENDING")
  createdAt      DateTime      @default(now())
}

model Review {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id])
  productId          String
  product            Product         @relation(fields: [productId], references: [id])
  customerId         String
  customerProfile    CustomerProfile @relation(fields: [customerId], references: [id])
  cookerId           String
  cooker             CookerProfile   @relation(fields: [cookerId], references: [id])
  productRating      Int             @default(5)
  cookerRating       Int             @default(5)
  deliveryRating     Int?
  tasteRating        Int?
  freshnessRating    Int?
  packagingRating    Int?
  comment            String
  isVerifiedPurchase Boolean         @default(true)
  isHiddenByAdmin    Boolean         @default(false)
  createdAt          DateTime        @default(now())
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  discountType      String       @default("FIXED")
  discountValue     Decimal      @db.Decimal(10, 2)
  minOrderValue     Decimal      @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  validFrom         DateTime
  validUntil        DateTime
  usageLimit        Int          @default(100)
  timesUsed         Int          @default(0)
  isActive          Boolean      @default(true)
  description       String
}

model OTPVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DeliveryZone {
  id           String  @id @default(uuid())
  name         String
  minKm        Float
  maxKm        Float
  deliveryFee  Decimal @db.Decimal(10, 2)
  isActive     Boolean @default(true)
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  targetType String
  targetId   String
  details    String
  timestamp  DateTime @default(now())
}
